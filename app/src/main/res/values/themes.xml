<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FinanceTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/income</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/expense</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_system_bars</item>

        <item name="alertDialogTheme">@style/FinanceDialog</item>
        <item name="android:alertDialogTheme">@style/FinanceDialog</item>
        <item name="android:datePickerDialogTheme">@style/FinanceDatePicker</item>
        <item name="bottomSheetDialogTheme">@style/FinanceBottomSheet</item>
        <item name="snackbarStyle">@style/FinanceSnackbar</item>
        <item name="snackbarTextViewStyle">@style/FinanceSnackbarText</item>
        <item name="snackbarButtonStyle">@style/FinanceSnackbarButton</item>
    </style>

    <!-- ===== Dialogs ===== -->
    <style name="FinanceDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/bg_card</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="buttonBarPositiveButtonStyle">@style/FinanceDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/FinanceDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/FinanceDialogButton</item>
    </style>

    <style name="FinanceDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="FinanceDatePicker" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/bg_card</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="FinanceBottomSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/FinanceBottomSheetStyle</item>
        <item name="android:navigationBarColor">@color/bg_card</item>
    </style>
    <style name="FinanceBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/bg_card</item>
        <item name="shapeAppearanceOverlay">@style/FinanceBottomSheetShape</item>
    </style>
    <style name="FinanceBottomSheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <style name="FinanceSnackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="backgroundTint">@color/bg_elevated</item>
    </style>
    <style name="FinanceSnackbarText" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="FinanceSnackbarButton" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- ===== Typography ===== -->
    <style name="Text" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.ScreenTitle">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.Section">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Text.Hero">
        <item name="android:textSize">36sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="Text.Stat">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Text.BodyBold">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Muted">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ===== Components ===== -->
    <style name="Card">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Card.Flush">
        <item name="android:padding">0dp</item>
    </style>
    <style name="IconTile">
        <item name="android:layout_width">@dimen/icon_tile</item>
        <item name="android:layout_height">@dimen/icon_tile</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">19sp</item>
        <item name="android:background">@drawable/rounded_rect</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/icon_button_bg</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/text_primary</item>
    </style>
    <style name="Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
    </style>
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="GhostButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="FilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
