<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="24dp" android:paddingBottom="96dp">

            <!-- Header -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="18dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tv_greeting" style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good morning"/>
                    <TextView style="@style/Text.ScreenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/app_name" android:layout_marginTop="2dp"/>
                </LinearLayout>
                <ImageButton android:id="@+id/btn_settings" style="@style/IconButton"
                    android:src="@drawable/ic_settings" android:contentDescription="@string/settings"/>
            </LinearLayout>

            <com.personal.financetracker.ui.common.PeriodPickerView android:id="@+id/period_picker"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp"/>

            <!-- Hero -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="22dp" android:background="@drawable/hero_gradient"
                android:layout_marginBottom="@dimen/row_gap">
                <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/this_period_net" android:textColor="#B6E9DD"/>
                <TextView android:id="@+id/tv_net" style="@style/Text.Hero"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/white" android:layout_marginTop="6dp" android:text="@string/empty_amount"/>
                <TextView android:id="@+id/tv_hero_sub" style="@style/Text.Caption"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#B6E9DD" android:layout_marginTop="6dp"/>
                <com.personal.financetracker.ui.common.RatioBarView android:id="@+id/bar_hero"
                    android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="16dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:background="@drawable/hero_inner" android:padding="12dp" android:layout_marginEnd="5dp">
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="↑ Income" android:textColor="#B6E9DD"/>
                        <TextView android:id="@+id/tv_hero_income" style="@style/Text.BodyBold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/white" android:textSize="15sp" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:background="@drawable/hero_inner" android:padding="12dp" android:layout_marginStart="5dp">
                        <TextView style="@style/Text.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="↓ Spent" android:textColor="#B6E9DD"/>
                        <TextView android:id="@+id/tv_hero_expense" style="@style/Text.BodyBold"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="@color/white" android:textSize="15sp" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="14dp">
                    <TextView style="@style/Text.Caption" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/total_balance" android:textColor="#B6E9DD"/>
                    <TextView android:id="@+id/tv_balance" style="@style/Text.BodyBold"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/white"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Insight tiles 2x2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp">
                <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="5dp" android:padding="14dp">
                    <TextView style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/daily_average"/>
                    <TextView android:id="@+id/tv_daily" style="@style/Text.Stat"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:layout_marginTop="4dp"/>
                    <TextView style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="spent per day" android:layout_marginTop="2dp" android:textSize="11sp"/>
                </LinearLayout>
                <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="5dp" android:padding="14dp">
                    <TextView style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/projected"/>
                    <TextView android:id="@+id/tv_projected" style="@style/Text.Stat"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/tv_projected_sub" style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="month-end spend" android:layout_marginTop="2dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="@dimen/row_gap">
                <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="5dp" android:padding="14dp">
                    <TextView style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spending change"/>
                    <TextView android:id="@+id/tv_vs" style="@style/Text.Stat"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="17sp" android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/tv_vs_sub" style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/vs_previous" android:layout_marginTop="2dp" android:textSize="11sp"/>
                </LinearLayout>
                <LinearLayout style="@style/Card" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginStart="5dp" android:padding="14dp">
                    <TextView style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/top_category"/>
                    <TextView android:id="@+id/tv_top_cat" style="@style/Text.Stat"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:layout_marginTop="5dp"
                        android:maxLines="1" android:ellipsize="end"/>
                    <TextView android:id="@+id/tv_top_cat_sub" style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="3dp" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Top categories -->
            <LinearLayout android:id="@+id/card_categories" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/row_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/Text.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/spending_by_category"/>
                    <TextView android:id="@+id/tv_see_reports" style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Reports →" android:textColor="@color/accent" android:textStyle="bold" android:padding="4dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/ll_categories" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- Upcoming -->
            <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/row_gap">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/Text.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/upcoming"/>
                    <TextView android:id="@+id/tv_see_planned" style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Planned →" android:textColor="@color/accent" android:textStyle="bold" android:padding="4dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/ll_upcoming" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/tv_upcoming_empty" style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/no_upcoming" android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- Recurring -->
            <LinearLayout android:id="@+id/card_recurring" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/row_gap">
                <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/recurring"/>
                <LinearLayout android:id="@+id/ll_recurring" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Recent -->
            <LinearLayout android:id="@+id/card_recent" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/Text.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/recent"/>
                    <TextView android:id="@+id/tv_see_all" style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="See all →" android:textColor="@color/accent" android:textStyle="bold" android:padding="4dp"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_recent"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/empty_state" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center" android:paddingVertical="40dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="44sp" android:layout_marginBottom="10dp"/>
                <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_transactions_yet" android:textColor="@color/text_secondary"/>
                <TextView style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tap_plus_to_add" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab_add"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="20dp"
        android:src="@drawable/ic_add" app:backgroundTint="@color/accent" app:tint="@color/on_accent"
        app:elevation="8dp" android:contentDescription="@string/add_transaction"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
