<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_padding" android:paddingTop="16dp" android:paddingBottom="8dp">
        <ImageButton android:id="@+id/btn_back" style="@style/IconButton" android:src="@drawable/ic_back" android:contentDescription="Back"/>
        <TextView android:id="@+id/tv_title" style="@style/Text.Section" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:textSize="17sp" android:text="@string/add_transaction"/>
        <ImageButton android:id="@+id/btn_delete" style="@style/IconButton" android:src="@drawable/ic_delete"
            app:tint="@color/expense" android:contentDescription="@string/delete" android:visibility="invisible"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding" android:paddingBottom="24dp">

            <com.personal.financetracker.ui.common.SegmentedControl android:id="@+id/seg_type"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:segments="Expense|Income" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"/>

            <!-- Amount -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/amount"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:layout_marginBottom="22dp">
                <TextView android:id="@+id/tv_currency" style="@style/Text.Hero" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="€" android:textColor="@color/text_muted" android:textSize="34sp" android:layout_marginEnd="8dp"/>
                <EditText android:id="@+id/et_amount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:inputType="numberDecimal" android:hint="0.00" android:textColorHint="@color/text_faint"
                    android:textColor="@color/text_primary" android:textSize="40sp" android:textStyle="bold"
                    android:background="@null" android:paddingVertical="4dp" android:letterSpacing="-0.02" android:maxLines="1"/>
            </LinearLayout>

            <!-- Category -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/category"/>
            <com.google.android.material.chip.ChipGroup android:id="@+id/chip_group_category"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="22dp"
                app:singleSelection="true" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="4dp"/>

            <!-- Date -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/date"/>
            <com.google.android.material.chip.ChipGroup android:id="@+id/chip_group_date"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="22dp"
                app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="6dp">
                <com.google.android.material.chip.Chip android:id="@+id/chip_today" style="@style/FilterChip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/today"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_yesterday" style="@style/FilterChip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yesterday"/>
                <com.google.android.material.chip.Chip android:id="@+id/chip_pick" style="@style/FilterChip"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pick_date"
                    app:chipIcon="@drawable/ic_calendar" app:chipIconVisible="true" app:chipIconTint="@color/chip_text_selector" app:chipIconSize="16dp"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- Note -->
            <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/note_optional"/>
            <EditText android:id="@+id/et_note" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="@string/note_hint" android:layout_marginTop="8dp" android:imeOptions="actionDone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton android:id="@+id/btn_save" style="@style/PrimaryButton"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginHorizontal="@dimen/screen_padding" android:layout_marginBottom="16dp" android:layout_marginTop="4dp"
        android:text="@string/save_expense"/>
</LinearLayout>
