<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="24dp" android:paddingBottom="32dp">

        <!-- Title + compare selector -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <TextView style="@style/Text.ScreenTitle"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/reports"/>
            <LinearLayout android:id="@+id/btn_compare"
                android:layout_width="wrap_content" android:layout_height="34dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/pill_bg" android:paddingStart="12dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/tv_compare" style="@style/Text.Caption"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="vs previous month" android:textColor="@color/text_primary" android:textStyle="bold"/>
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_down" android:alpha="0.6" android:contentDescription="@null"/>
            </LinearLayout>
        </LinearLayout>

        <com.personal.financetracker.ui.common.PeriodPickerView android:id="@+id/period_picker"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp"/>

        <com.personal.financetracker.ui.common.SegmentedControl android:id="@+id/tabs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:segments="Spending|Income|Cash flow" android:layout_marginBottom="20dp"/>

        <include android:id="@+id/breakdown" layout="@layout/section_breakdown"/>
        <include android:id="@+id/cashflow" layout="@layout/section_cashflow"/>

        <LinearLayout android:id="@+id/empty_state"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:paddingVertical="56dp"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📊" android:textSize="44sp" android:layout_marginBottom="12dp"/>
            <TextView style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/no_data_period" android:textColor="@color/text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
