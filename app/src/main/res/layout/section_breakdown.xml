<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Hero total -->
    <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_gap">
        <TextView android:id="@+id/tv_total_label" style="@style/Text.Overline"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/total_spent"/>
        <TextView android:id="@+id/tv_total" style="@style/Text.Hero"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/empty_amount"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:id="@+id/tv_delta" style="@style/Text.BodyBold"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp"/>
            <TextView android:id="@+id/tv_delta_sub" style="@style/Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"/>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginVertical="14dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <include android:id="@+id/stat_per_day" layout="@layout/item_stat_tile"/>
            <include android:id="@+id/stat_per_tx" layout="@layout/item_stat_tile"/>
            <include android:id="@+id/stat_count" layout="@layout/item_stat_tile"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Trend -->
    <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_gap">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/trend"/>
                <TextView android:id="@+id/tv_trend_sub" style="@style/Text.Muted"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView android:id="@+id/tv_trend_avg" style="@style/Text.Caption"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/pill_bg" android:paddingHorizontal="10dp" android:paddingVertical="5dp"/>
        </LinearLayout>
        <com.github.mikephil.charting.charts.BarChart android:id="@+id/chart_trend"
            android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="10dp"/>
        <TextView style="@style/Text.Muted" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/trend_hint" android:gravity="center" android:layout_marginTop="4dp" android:textSize="11sp"/>
    </LinearLayout>

    <!-- Categories -->
    <LinearLayout style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_gap">
        <TextView android:id="@+id/tv_cat_title" style="@style/Text.Section"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/by_category"/>
        <com.personal.financetracker.ui.common.StackedBarView android:id="@+id/stacked_bar"
            android:layout_width="match_parent" android:layout_height="12dp" android:layout_marginTop="12dp"/>
        <TextView style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/category_hint" android:layout_marginTop="8dp" android:layout_marginBottom="4dp" android:textSize="11sp"/>
        <LinearLayout android:id="@+id/ll_categories"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>

    <!-- Pace (expense only) -->
    <LinearLayout android:id="@+id/card_pace" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_gap">
        <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/spending_pace"/>
        <TextView android:id="@+id/tv_pace_sub" style="@style/Text.Muted"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/spending_pace_sub"/>
        <com.github.mikephil.charting.charts.LineChart android:id="@+id/chart_pace"
            android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="10dp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp" android:layout_gravity="center">
            <View android:layout_width="10dp" android:layout_height="3dp" android:background="@color/accent"/>
            <TextView android:id="@+id/tv_pace_legend_a" style="@style/Text.Muted"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginEnd="14dp"/>
            <View android:layout_width="10dp" android:layout_height="3dp" android:background="@color/series_prev"/>
            <TextView android:id="@+id/tv_pace_legend_b" style="@style/Text.Muted"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Weekday (expense only) -->
    <LinearLayout android:id="@+id/card_weekday" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_gap">
        <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/by_weekday"/>
        <TextView style="@style/Text.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="@string/by_weekday_sub"/>
        <com.github.mikephil.charting.charts.BarChart android:id="@+id/chart_weekday"
            android:layout_width="match_parent" android:layout_height="150dp" android:layout_marginTop="10dp"/>
    </LinearLayout>

    <!-- Top notes -->
    <LinearLayout android:id="@+id/card_notes" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_gap">
        <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/top_notes"/>
        <LinearLayout android:id="@+id/ll_notes"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp"/>
    </LinearLayout>

    <!-- Largest -->
    <LinearLayout android:id="@+id/card_largest" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_gap">
        <TextView style="@style/Text.Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/largest_transactions"/>
        <LinearLayout android:id="@+id/ll_largest"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp"/>
    </LinearLayout>
</LinearLayout>
