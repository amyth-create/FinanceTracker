<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="12dp" android:paddingBottom="28dp">

        <View android:layout_width="40dp" android:layout_height="4dp" android:background="@drawable/sheet_handle"
            android:layout_gravity="center" android:layout_marginBottom="18dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_emoji" style="@style/IconTile"
                android:layout_width="48dp" android:layout_height="48dp" android:textSize="22sp" android:layout_marginEnd="14dp"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tv_name" style="@style/Text.Section"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp"/>
                <TextView android:id="@+id/tv_period" style="@style/Text.Caption"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView android:id="@+id/tv_total" style="@style/Text.Stat"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="18dp">
            <include android:id="@+id/stat_share" layout="@layout/item_stat_tile"/>
            <include android:id="@+id/stat_count" layout="@layout/item_stat_tile"/>
            <include android:id="@+id/stat_avg" layout="@layout/item_stat_tile"/>
            <include android:id="@+id/stat_delta" layout="@layout/item_stat_tile"/>
        </LinearLayout>

        <TextView style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="@string/category_history"/>
        <com.github.mikephil.charting.charts.BarChart android:id="@+id/chart_history"
            android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="6dp"/>

        <TextView android:id="@+id/tv_tx_title" style="@style/Text.Overline" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Transactions"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_transactions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:nestedScrollingEnabled="false" android:layoutAnimation="@anim/layout_rise"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
